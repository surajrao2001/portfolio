# Environment variables (copy to .env.local)
# Never commit real secrets. Server-only keys below must NOT use NEXT_PUBLIC_.

# Site (public)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form — Resend (required at runtime for POST /api/contact)
# Create an API key at https://resend.com
RESEND_API_KEY=
# Inbox that receives form submissions (you)
CONTACT_TO_EMAIL=
# Verified sender in Resend. For local/dev, Resend allows onboarding@resend.dev
# once you have an API key; production needs a domain you verify.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Rate limiting — Upstash Redis REST (required at runtime for POST /api/contact)
# Create a Redis database at https://upstash.com and copy REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Notes:
# - Build (`npm run build`) succeeds without these keys.
# - A real POST without valid config returns 503 with a generic client message.
# - Rate limit: 5 requests per IP per rolling hour (see lib/contact/rate-limit.ts).
